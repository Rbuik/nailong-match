  "chapters": [
    {
      "id": 1,
      "name": "第一章 · 奶龙的草地午后",
      "theme": "grass",
      "from": 1,
      "to": 10,
      "emoji": "🌱",
      "story": "奶龙在草地上打了个滚，捡到一颗会发光的糖。糖纸里裹着一张皱巴巴的地图，画着回家的路。"
    },
    {
      "id": 2,
      "name": "第二章 · 奶龙海底捞钥匙",
      "theme": "ocean",
      "from": 11,
      "to": 20,
      "emoji": "🌊",
      "story": "地图指向海底的沉船。钥匙被浪打散在珊瑚缝里，奶龙憋着气，一颗一颗把它捞回来。"
    },
    {
      "id": 3,
      "name": "第三章 · 奶龙去闯荡星空",
      "theme": "star",
      "from": 21,
      "to": 30,
      "emoji": "🌌",
      "story": "沉船里的星图忽然亮了，光点连成一条通往天上的路。奶龙踩着星光往上爬。"
    },
    {
      "id": 4,
      "name": "第四章 · 奶龙的糖果城堡",
      "theme": "candy",
      "from": 31,
      "to": 40,
      "emoji": "🍬",
      "story": "最后一站。糖果城堡的大门只为「把糖完整带回家」的奶龙打开。"
    },
    {
      "id": 5,
      "name": "第五章 · 奶龙的藤蔓花园",
      "theme": "forest",
      "from": 41,
      "to": 50,
      "emoji": "🌿",
      "story": "花园里的藤蔓一夜之间爬满了小路。奶龙提着灯笼往里走，边走边把缠住脚的枝条剪开——它得在藤蔓把整座花园吞掉之前找到出口。"
    },
    {
      "id": 6,
      "name": "第六章 · 奶龙的云端轨道",
      "theme": "sky",
      "from": 51,
      "to": 60,
      "emoji": "☁️",
      "story": "出口通向云上。云做的轨道每隔几步就自己挪一格，两扇紫色的门把货物送到对面。奶龙抱紧糖果，踩着滑动的云往前走。"
    },
    {
      "id": 7,
      "name": "第七章 · 奶龙的流沙遗迹",
      "theme": "desert",
      "from": 61,
      "to": 70,
      "emoji": "🏜️",
      "story": "云散了，底下是一片会吃人的沙子。雾气里什么都看不清，奶龙只能靠摸——摸着摸着，脚底已经陷下去半寸。"
    },
    {
      "id": 8,
      "name": "第八章 · 奶龙的熔岩宝库",
      "theme": "lava",
      "from": 71,
      "to": 80,
      "emoji": "🔥",
      "story": "宝库在火山口。上锁的箱子、滴答倒数的炸弹，最后一道门后就是回家的钥匙。奶龙深吸一口气，冲了进去。"
    }
  ],
