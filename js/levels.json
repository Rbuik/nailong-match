  "chapters": [
    {
      "id": 1,
      "name": "第一章 · 奶龙的草地午后",
      "theme": "grass",
      "from": 1,
      "to": 10,
      "emoji": "🌱",
      "story": "奶龙在草地上打了个滚，捡到一颗会发光的糖。糖纸里裹着一张皱巴巴的地图，画着回家的路。"
    },
    {
      "id": 2,
      "name": "第二章 · 奶龙海底捞钥匙",
      "theme": "ocean",
      "from": 11,
      "to": 20,
      "emoji": "🌊",
      "story": "地图指向海底的沉船。钥匙被浪打散在珊瑚缝里，奶龙憋着气，一颗一颗把它捞回来。"
    },
    {
      "id": 3,
      "name": "第三章 · 奶龙闯星空",
      "theme": "star",
      "from": 21,
      "to": 30,
      "emoji": "🌌",
      "story": "沉船里的星图忽然亮了，光点连成一条通往天上的路。奶龙踩着星光往上爬。"
    },
    {
      "id": 4,
      "name": "第四章 · 奶龙的糖果城堡",
      "theme": "candy",
      "from": 31,
      "to": 40,
      "emoji": "🍬",
      "story": "最后一站。糖果城堡的大门只为「把糖完整带回家」的奶龙打开。"
    }
  ],
